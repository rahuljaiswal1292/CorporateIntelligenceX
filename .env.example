# ScrapingBee API Key (Required for web scraping)
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here

# Market Data Time-to-Live in hours (default: 24)
MARKET_DATA_TTL=24

# LLM Model (gpt-4o or gemini-2.0-flash)
LLM_MODEL=gpt-4o

# Vector Database Path
VECTOR_DB_PATH=./data/chroma_store

# Default Timeframe for Quarterly Reports
DEFAULT_TIMEFRAME_QTR=12

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# UI Theme
UI_THEME=corporate_blue